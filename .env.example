# Размер акции в процентах. 0 — акция выключена, показывается только прайсовая цена.
# По умолчанию 40.
NEXT_PUBLIC_PROMO_PERCENT=40

# Проигрывать вход при каждой перезагрузке (для отладки).
# В режиме разработки включено само; 1 — включить и на боевом, 0 — выключить везде.
NEXT_PUBLIC_REPLAY_ENTRY=

# Публичный адрес сайта без завершающего слэша.
# Используется картой сайта, robots.txt и Open Graph. По умолчанию localhost.
NEXT_PUBLIC_SITE_URL=
